<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- PUBLISH SETTINGS -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>         <!-- change to win-arm64 if needed -->
    <SelfContained>true</SelfContained>                    <!-- bundle .NET runtime -->
    <PublishSingleFile>true</PublishSingleFile>            <!-- one .exe -->
    <PublishTrimmed>false</PublishTrimmed>                 <!-- safer with reflection-heavy libs -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.TextToSpeech.V1" Version="3.12.0" />
    <PackageReference Include="OpenAI" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="9.0.7" />
  </ItemGroup>

<ItemGroup>
  <None Include="appsettings.json">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
  </None>
  <None Include="automated-lodge-466210-u4-279b32a10295.json">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
  </None>
</ItemGroup>

</Project>
